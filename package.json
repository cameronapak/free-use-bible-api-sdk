{
  "name": "free-use-bible-api-sdk",
  "version": "1.15.1",
  "description": "Type-safe TypeScript SDK for the Free Use Bible API",
  "keywords": [
    "bible",
    "bible-api",
    "openapi",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/cameronapak/free-use-bible-api-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameronapak/free-use-bible-api-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/cameronapak/free-use-bible-api-sdk/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "openapi.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:spec": "bun scripts/sync-openapi.ts",
    "check:spec": "bun scripts/sync-openapi.ts --check",
    "generate": "openapi-ts && bun scripts/patch-generated.ts",
    "check:generated": "bun scripts/check-generated.ts",
    "lint": "redocly lint openapi.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests/sdk.test.ts",
    "test:contract": "bun test ./tests/contract.test.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:docs": "redocly build-docs openapi.json --output dist/redoc-static.html",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:source": "bun run lint && bun run typecheck && bun run test && bun run check:generated && bun run build",
    "check": "bun run check:source && bun run check:package",
    "prepack": "bun run check:source"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.54.3",
    "@types/bun": "1.4.2",
    "publint": "0.3.24",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.3.10"
}
