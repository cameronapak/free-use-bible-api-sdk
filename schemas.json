{
  "components": {
    "schemas": {
      "Translation": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "englishName": { "type": "string" },
          "website": { "type": "string" },
          "licenseUrl": { "type": "string" },
          "shortName": { "type": "string" },
          "language": { "type": "string" },
          "languageName": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
          "languageEnglishName": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
          "textDirection": { "type": "string", "enum": ["ltr", "rtl"] },
          "availableFormats": {
            "type": "array",
            "items": { "type": "string", "enum": ["json", "usfm"] }
          },
          "listOfBooksApiLink": { "type": "string" },
          "numberOfBooks": { "type": "integer" },
          "totalNumberOfChapters": { "type": "integer" },
          "totalNumberOfVerses": { "type": "integer" },
          "numberOfApocryphalBooks": { "oneOf": [ { "type": "integer" }, { "type": "null" } ] },
          "totalNumberOfApocryphalChapters": { "oneOf": [ { "type": "integer" }, { "type": "null" } ] },
          "totalNumberOfApocryphalVerses": { "oneOf": [ { "type": "integer" }, { "type": "null" } ] }
        },
        "required": ["id", "name", "englishName", "website", "licenseUrl", "shortName", "language", "textDirection", "availableFormats", "listOfBooksApiLink", "numberOfBooks", "totalNumberOfChapters", "totalNumberOfVerses"]
      },
      "TranslationBook": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "translationId": { "type": "string" },
          "name": { "type": "string" },
          "commonName": { "type": "string" },
          "title": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
          "order": { "type": "integer" },
          "numberOfChapters": { "type": "integer" },
          "firstChapterApiLink": { "type": "string" },
          "lastChapterApiLink": { "type": "string" },
          "totalNumberOfVerses": { "type": "integer" },
          "isApocryphal": { "oneOf": [ { "type": "boolean" }, { "type": "null" } ] }
        },
        "required": ["id", "translationId", "name", "commonName", "order", "numberOfChapters", "firstChapterApiLink", "lastChapterApiLink", "totalNumberOfVerses"]
      },
      "ChapterHeading": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["heading"] },
          "content": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["type", "content"]
      },
      "ChapterLineBreak": {
        "type": "object",
        "properties": { "type": { "type": "string", "enum": ["line_break"] } },
        "required": ["type"]
      },
      "ChapterHebrewSubtitle": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["hebrew_subtitle"] },
          "content": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "$ref": "#/components/schemas/FormattedText" },
                { "$ref": "#/components/schemas/VerseFootnoteReference" }
              ]
            }
          }
        },
        "required": ["type", "content"]
      },
      "ChapterVerse": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["verse"] },
          "number": { "type": "integer" },
          "content": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "$ref": "#/components/schemas/FormattedText" },
                { "$ref": "#/components/schemas/InlineHeading" },
                { "$ref": "#/components/schemas/InlineLineBreak" },
                { "$ref": "#/components/schemas/VerseFootnoteReference" }
              ]
            }
          }
        },
        "required": ["type", "number", "content"]
      },
      "ChapterContent": {
        "oneOf": [
          { "$ref": "#/components/schemas/ChapterHeading" },
          { "$ref": "#/components/schemas/ChapterLineBreak" },
          { "$ref": "#/components/schemas/ChapterHebrewSubtitle" },
          { "$ref": "#/components/schemas/ChapterVerse" }
        ]
      },
      "FormattedText": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "poem": { "oneOf": [ { "type": "integer" }, { "type": "null" } ] },
          "wordsOfJesus": { "oneOf": [ { "type": "boolean" }, { "type": "null" } ] }
        },
        "required": ["text"]
      },
      "InlineHeading": {
        "type": "object",
        "properties": { "heading": { "type": "string" } },
        "required": ["heading"]
      },
      "InlineLineBreak": {
        "type": "object",
        "properties": { "lineBreak": { "type": "boolean" } },
        "required": ["lineBreak"]
      },
      "VerseFootnoteReference": {
        "type": "object",
        "properties": { "noteId": { "type": "integer" } },
        "required": ["noteId"]
      },
      "ChapterFootnote": {
        "type": "object",
        "properties": {
          "noteId": { "type": "integer" },
          "text": { "type": "string" },
          "reference": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "chapter": { "type": "integer" },
                  "verse": { "type": "integer" }
                }
              },
              { "type": "null" }
            ]
          },
          "caller": { "type": ["string", "null"] }
        },
        "required": ["noteId", "text", "caller"]
      },
      "ChapterData": {
        "type": "object",
        "properties": {
          "number": { "type": "integer" },
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChapterContent" }
          },
          "footnotes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChapterFootnote" }
          }
        },
        "required": ["number", "content", "footnotes"]
      },
      "AudioLinks": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      },
      "AvailableTranslations": {
        "type": "object",
        "properties": {
          "translations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Translation" }
          }
        },
        "required": ["translations"]
      },
      "TranslationBooks": {
        "type": "object",
        "properties": {
          "translation": { "$ref": "#/components/schemas/Translation" },
          "books": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TranslationBook" }
          }
        },
        "required": ["translation", "books"]
      },
      "TranslationBookChapter": {
        "type": "object",
        "properties": {
          "translation": { "$ref": "#/components/schemas/Translation" },
          "book": { "$ref": "#/components/schemas/TranslationBook" },
          "thisChapterApiLink": { "type": "string" },
          "thisChapterAudioLinks": { "$ref": "#/components/schemas/AudioLinks" },
          "nextChapterApiLink": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
          "nextChapterAudioLinks": { "oneOf": [ { "$ref": "#/components/schemas/AudioLinks" }, { "type": "null" } ] },
          "previousChapterApiLink": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
          "previousChapterAudioLinks": { "oneOf": [ { "$ref": "#/components/schemas/AudioLinks" }, { "type": "null" } ] },
          "numberOfVerses": { "type": "integer" },
          "chapter": { "$ref": "#/components/schemas/ChapterData" }
        },
        "required": ["translation", "book", "thisChapterApiLink", "thisChapterAudioLinks", "numberOfVerses", "chapter"]
      },
    }
  },
  "paths": {
    "/api/available_translations": {
      "$ref": "available-translations.json#/api/available_translations"
    },
    "/api/{translation}/books": {
      "$ref": "list-books-translation.json#/api/{translation}/books"
    },
    "/api/{translation}/{book}/{chapter}": {
      "$ref": "get-chapter-translation.json#/api/{translation}/{book}/{chapter}"
    }
  }
}